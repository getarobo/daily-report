<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.genehan.daily-report.healthcheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/genehan/projects/claudehome-projects/daily-report/.venv/bin/python</string>
        <string>-m</string>
        <string>daily_report</string>
        <string>healthcheck</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/genehan/projects/claudehome-projects/daily-report</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/genehan/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/genehan/</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <!-- Weekdays Mon–Fri at 08:40 KST (10 min after main job) -->
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>40</integer></dict>
        <!-- Sat & Sun at 10:10 KST -->
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>10</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/genehan/Library/Logs/daily-report.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/genehan/Library/Logs/daily-report.log</string>
</dict>
</plist>
