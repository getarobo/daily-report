# Non-secret routing only. Copy to .env (gitignored) and fill in.
# All real secrets live in macOS Keychain via `keyring`, not here.
TELEGRAM_CHAT_ID=

# Apple ID used during `python -m icalendar_sync setup`.
# Tells the icalendar-sync skill which keyring entry to look up for the
# CalDAV password. The password itself stays in Keychain.
ICLOUD_USERNAME=
